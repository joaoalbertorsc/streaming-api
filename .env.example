# Copy to .env and adjust. Read by docker compose and by Spring Boot (spring.config.import).
DB_URL=jdbc:postgresql://localhost:5432/streaming
DB_USERNAME=streaming
DB_PASSWORD=streaming
# At least 32 characters (HMAC-SHA256). Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
